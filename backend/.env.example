APP_NAME="Society Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Pakistan-wide deployment: keep this fixed regardless of server location.
APP_TIMEZONE=Asia/Karachi
APP_URL=https://api.yoursociety.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database (MySQL on cPanel: Setup MySQL Databases) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpanel_user_societydb
DB_USERNAME=cpanel_user_dbuser
DB_PASSWORD=

# Token auth only (mobile + static-export web); no session-based SPA auth,
# but Laravel still needs a session/cache/queue store - all use the
# database driver so nothing extra needs installing on shared hosting.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# --- CORS: the Next.js panel's domain(s), comma-separated. '*' for local dev only. ---
CORS_ALLOWED_ORIGINS=https://panel.yoursociety.com

# --- Mail (GoDaddy/cPanel mailbox SMTP - optional channel, see docs/decisions.md) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.yoursociety.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=noreply@yoursociety.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@yoursociety.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Firebase Cloud Messaging (push notifications; SOS high-priority channel) ---
# Service-account JSON path (upload outside public/, e.g. storage/app/firebase/service-account.json)
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json
FIREBASE_PROJECT_ID=

# --- Payment gateways (Payments module; add real keys per gateway when wired) ---
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

VITE_APP_NAME="${APP_NAME}"
