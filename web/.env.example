# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
BASEPATH=
NEXT_PUBLIC_APP_URL=http://localhost:3000${BASEPATH}

# -----------------------------------------------------------------------------
# API (Laravel backend - see backend/.env.example and docs/deployment.md)
# -----------------------------------------------------------------------------
# Must be reachable from the browser (this is a static-exported client-side
# app with no server of its own) - e.g. https://api.yoursociety.com/api/v1
# in production, http://localhost:8000/api/v1 for local dev against
# `php artisan serve`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
